# Copy to .env and fill in real values. Never commit .env.
# This file is the template — keep it placeholder-only, real secrets go in
# .env (gitignored), never here.
#
# This project needs its OWN Supabase project (separate from the sibling
# videoMaker repo's project) and its OWN YouTube channel/OAuth app — do
# not point these at the sibling's credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for direct psql/CLI db access, not for app code:
SUPABASE_DB_PASSWORD=

# YouTube Data API v3 (publishing). Needs its own Google Cloud project +
# OAuth consent screen (Testing mode to start) for this channel, separate
# from any other project's. See the plan's YouTube setup section for the
# refresh-token expiry caveat on unverified (Testing-mode) OAuth apps —
# this channel posts up to 7x/week on an unattended cron, so submit for
# verification early rather than deferring it.
# YOUTUBE_API_KEY is read-only (search/public metadata) — it cannot
# upload or act on a channel. Actual publishing needs the OAuth trio
# below too, obtained via worker/src/jobs/youtube-oauth-bootstrap.ts.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Defaults to "private" if unset — see the PRIVACY_STATUS comment in
# worker/src/jobs/publish-episode.ts. This is a brand-new, unverified
# channel/OAuth app, so don't flip the scheduled workflows to "public"
# until a manual run has confirmed actualPrivacyStatus is honored.
YOUTUBE_UPLOAD_PRIVACY_STATUS=

# LLM provider for script writing (write-script.ts) and the automated
# content-safety gate (safety-check.ts) — same env var name the sibling
# videoMaker project already uses.
ANTHROPIC_API_KEY=

# Google Gemini image generation (worker/src/jobs/generate-assets.ts
# only — nothing else in the pipeline reads this). Get a key from Google
# AI Studio (aistudio.google.com). Used to generate the mascot's pose
# frames, the living-room background, and per-vocabulary-word photos —
# all cached in Storage + the image_assets table and generated once
# rather than per episode, so ongoing runtime cost is low; this key only
# needs to be present when (re)running generate-assets, not for normal
# render-episode runs.
GEMINI_API_KEY=

# Text-to-speech provider selection. Defaults to "elevenlabs" if unset —
# only "elevenlabs" is implemented today (see worker/src/lib/tts/).
TTS_PROVIDER=
# ElevenLabs (premium TTS, timestamped synthesis endpoint). Pick a warm,
# kid-friendly narrator voice in the ElevenLabs voice library and use its
# voice_id here.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
