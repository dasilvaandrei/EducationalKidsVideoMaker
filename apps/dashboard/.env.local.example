# Copy to .env.local and fill in real values. Never commit .env.local.
# This is KidsVideoMaker's own Supabase project — a separate project from
# the sibling videoMaker repo's dashboard, even though the variable names
# match. See ../../supabase/migrations for this project's schema. The
# NEXT_PUBLIC_ prefix is required by Next.js to expose a var to the browser
# client (src/lib/supabase/client.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where this app is actually reachable from — used to build the
# password-reset email's redirect link (src/app/forgot-password/actions.ts).
# https://review.andreidasilva.com in production, http://localhost:3000
# for local dev (the code already falls back to that if this is unset).
NEXT_PUBLIC_SITE_URL=
